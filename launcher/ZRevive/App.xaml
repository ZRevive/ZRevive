<Application x:Class="ZRevive.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Colours sampled from the ZRevive logo; same values as the website. -->
    <SolidColorBrush x:Key="Ink" Color="#0E0D0C"/>
    <SolidColorBrush x:Key="Ink2" Color="#151413"/>
    <SolidColorBrush x:Key="Ink3" Color="#1C1A18"/>
    <SolidColorBrush x:Key="Ink4" Color="#242120"/>
    <SolidColorBrush x:Key="Line" Color="#2B2825"/>
    <SolidColorBrush x:Key="Line2" Color="#3A3632"/>
    <SolidColorBrush x:Key="Bone" Color="#EBE6DD"/>
    <SolidColorBrush x:Key="Ash" Color="#9B958B"/>
    <SolidColorBrush x:Key="Ash2" Color="#6F6A62"/>
    <SolidColorBrush x:Key="Red" Color="#C4161C"/>
    <SolidColorBrush x:Key="RedHi" Color="#E1262C"/>
    <SolidColorBrush x:Key="RedDim" Color="#4DC4161C"/>
    <SolidColorBrush x:Key="Ok" Color="#7CC47F"/>
    <SolidColorBrush x:Key="Gold" Color="#D9A441"/>
    <SolidColorBrush x:Key="Steam" Color="#171A21"/>
    <SolidColorBrush x:Key="SteamLine" Color="#2A475E"/>
    <SolidColorBrush x:Key="SteamText" Color="#C7D5E0"/>
    <FontFamily x:Key="Head">Bahnschrift SemiCondensed, Bahnschrift Condensed, Arial Narrow, Segoe UI</FontFamily>

    <!-- Hero backdrop: dark vignette + subtle diagonal grain so the big empty area doesn't look flat. -->
    <RadialGradientBrush x:Key="HeroGlow" Center="0.3,0.25" GradientOrigin="0.3,0.25" RadiusX="0.9" RadiusY="0.9">
      <GradientStop Color="#40C4161C" Offset="0"/>
      <GradientStop Color="#120E0D0C" Offset="0.55"/>
      <GradientStop Color="#000E0D0C" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="HeroBase" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#1A1816" Offset="0"/>
      <GradientStop Color="#0E0D0C" Offset="1"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="Grain" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Opacity="0.35">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#07FFFFFF" Geometry="M0,0 L1,0 L1,1 L0,1 Z"/>
          <GeometryDrawing Brush="#05000000" Geometry="M3,3 L4,3 L4,4 L3,4 Z"/>
          <GeometryDrawing Brush="#04FFFFFF" Geometry="M4,1 L5,1 L5,2 L4,2 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="HeroFade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#000E0D0C" Offset="0"/>
      <GradientStop Color="#CC0E0D0C" Offset="0.75"/>
      <GradientStop Color="#FF0E0D0C" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Ink3}"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Small uppercase field label -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ash2}"/>
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Red condensed section heading, like the in-game CUSTOMIZE / INVENTORY headers -->
    <Style x:Key="SectionHead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource RedHi}"/>
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Big display headline -->
    <Style x:Key="Display" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="54"/>
      <Setter Property="LineHeight" Value="52"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#CC151413"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <!-- Stat tile: big number + caption -->
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
    </Style>
    <Style x:Key="StatCaption" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
      <Setter Property="CaretBrush" Value="{StaticResource RedHi}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Red}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ash2}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Red}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Ink3}"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ash}"/>
                <Setter TargetName="b" Property="Background" Value="{StaticResource Ink4}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Red}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource RedHi}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource RedHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The big PLAY button: slanted red slab with a glow on hover -->
    <Style x:Key="PlayBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="260"/>
      <Setter Property="Height" Value="68"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="3" Background="{StaticResource RedHi}" Opacity="0" Margin="-2">
                <Border.Effect>
                  <BlurEffect Radius="18"/>
                </Border.Effect>
              </Border>
              <Border x:Name="b" CornerRadius="3" BorderThickness="1" BorderBrush="#E1262C">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E1262C" Offset="0"/>
                    <GradientStop Color="#B5131A" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Border Width="6" HorizontalAlignment="Left" Background="#55000000" CornerRadius="3,0,0,3"/>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26,0"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="1"/>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="glow" Property="Opacity" Value="0.25"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                <Setter TargetName="glow" Property="Opacity" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SteamBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Steam}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SteamLine}"/>
      <Setter Property="Foreground" Value="{StaticResource SteamText}"/>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ash}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"
                       FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Foreground" Value="{StaticResource Bone}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title-bar buttons -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ash}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Ink4}"/>
                <Setter Property="Foreground" Value="{StaticResource Bone}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeClose" TargetType="Button" BasedOn="{StaticResource Chrome}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark checkbox with a red tick box -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ash}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="2" BorderThickness="1"
                      BorderBrush="{StaticResource Line2}" Background="{StaticResource Ink}" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M3,9 L7,13 L15,4" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Red}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource RedHi}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ash}"/>
                <Setter Property="Foreground" Value="{StaticResource Bone}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Install progress bar: dark trough, red fill -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="2">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#E1262C" Offset="0"/>
                      <GradientStop Color="#B5131A" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A selectable row in the "we found these installs" list -->
    <Style x:Key="PickRow" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="2" Padding="12,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ash2}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Red}"/>
                <Setter TargetName="b" Property="Background" Value="#14C4161C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin dark scrollbar for the news list -->
    <Style x:Key="ThinThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{StaticResource Line2}" CornerRadius="2" Margin="1"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ThinThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="6"/>
          <Setter Property="Width" Value="Auto"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
